PORT=3000
JWT_SECRET=change-me-in-production

# Public URL of the app, used to build links in emails (e.g. password reset).
# Leave unset in local dev to fall back to the request's Origin header.
APP_URL=

# SMTP settings for sending real emails (e.g. Gmail with an App Password:
# https://myaccount.google.com/apppasswords — requires 2-Step Verification on).
# If left unset, emails are logged to the console instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=your-gmail-address@gmail.com
